{
  "name": "@full-stack-example/api",
  "version": "0.1.0",
  "private": true,
  "description": "Server workspace for the Hono API, Jobs Worker, migrations, and admin provisioning processes.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --exclude ../../logs/** src/entrypoints/api.ts",
    "start": "node dist/entrypoints/api.js",
    "migrate": "node dist/entrypoints/migrate.js",
    "migrate:dev": "tsx src/entrypoints/migrate.ts",
    "admin:provision": "node dist/entrypoints/admin-provision.js",
    "admin:provision:dev": "tsx src/entrypoints/admin-provision.ts",
    "jobs:worker": "node dist/entrypoints/jobs-worker.js",
    "jobs:worker:dev": "tsx watch src/entrypoints/jobs-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@full-stack-example/auth": "workspace:*",
    "@full-stack-example/database": "workspace:*",
    "@full-stack-example/logging": "workspace:*",
    "@full-stack-example/jobs": "workspace:*",
    "@full-stack-example/system": "workspace:*",
    "@full-stack-example/todos": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "@hono/otel": "^1.1.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "catalog:",
    "@logtape/hono": "^2.3.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "hono": "catalog:",
    "hono-openapi": "^1.3.2",
    "zod": "catalog:"
  }
}
