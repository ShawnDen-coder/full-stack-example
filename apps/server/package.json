{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -b ../../packages/api && tsdown",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/auth-schema.ts --output ../../packages/db/src/schema/auth.ts --yes",
		"test": "node --import tsx --test tests/*.test.ts"
	},
	"dependencies": {
		"@my-better-t-app/api": "workspace:*",
		"@my-better-t-app/auth": "workspace:*",
		"@my-better-t-app/db": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"varlock": "catalog:",
		"zod": "catalog:",
		"@my-better-t-app/users": "workspace:*",
		"@my-better-t-app/queue": "workspace:*",
		"@hono/node-server": "^2.1.1"
	},
	"devDependencies": {
		"@my-better-t-app/config": "workspace:*",
		"@types/node": "^26.4.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:",
		"@orpc/client": "catalog:"
	}
}
