{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -b ../../packages/api && tsdown",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/auth-schema.ts --output ../../packages/db/src/schema/auth.ts --yes",
		"test": "node --import tsx --test tests/*.test.ts",
		"test:integration": "node --import tsx --test tests/integration/*.test.ts"
	},
	"dependencies": {
		"@full-stack-example/api": "workspace:*",
		"@full-stack-example/db": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"varlock": "catalog:",
		"zod": "catalog:",
		"@full-stack-example/queue": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"@full-stack-example/observability": "workspace:*",
		"drizzle-orm": "catalog:",
		"@full-stack-example/business": "workspace:*",
		"pino": "catalog:",
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/sdk-node": "catalog:",
		"@opentelemetry/resources": "catalog:",
		"@opentelemetry/exporter-trace-otlp-http": "catalog:",
		"@opentelemetry/exporter-metrics-otlp-http": "catalog:",
		"@opentelemetry/sdk-metrics": "catalog:",
		"@opentelemetry/sdk-trace": "catalog:",
		"pg": "catalog:",
		"bullmq": "catalog:",
		"bullmq-otel": "catalog:"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:",
		"@orpc/client": "catalog:"
	},
	"files": [
		"dist",
		".env.schema"
	]
}
