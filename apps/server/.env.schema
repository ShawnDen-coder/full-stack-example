# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# BullMQ producer and worker connection
# @type=url
REDIS_URL=redis://localhost:6379

# @public @type=number(min=1, max=100)
DB_POOL_MAX=10

# @public @type=number(min=1)
DB_QUERY_TIMEOUT_MS=10000

# @public @type=port
PORT=3000

# @public @type=number(min=1)
SERVER_STARTUP_TIMEOUT_MS=10000

# @public @type=number(min=1)
SERVER_SHUTDOWN_TIMEOUT_MS=30000

# Export traces and metrics to an OTLP/HTTP collector. Independent of readiness.
# @public @type=boolean
OTEL_ENABLED=false

# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# @public
OTEL_SERVICE_VERSION=development

# Root trace sampling ratio; incoming sampling decisions are respected.
# @public @type=number(min=0, max=1)
OTEL_TRACES_SAMPLER_ARG=1

# @public @type=enum(trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info
