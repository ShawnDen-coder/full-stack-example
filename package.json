{
  "name": "full-stack-example",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "TypeScript modular monolith with a React web app, Hono API, PostgreSQL persistence, structured logging, and OpenTelemetry.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:generate": "pnpm --dir docs generate",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@full-stack-example/logging": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShawnDen-coder/full-stack-example.git"
  }
}
