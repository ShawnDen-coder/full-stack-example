DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_RUNTIME_URL=postgres://app_runtime:runtime@localhost:5432/app
DATABASE_MIGRATOR_URL=postgres://app_migrator:migrator@localhost:5432/app
# Required by container/compose.yaml to create the runtime and migrator database roles.
POSTGRES_RUNTIME_USER=app_runtime
POSTGRES_RUNTIME_PASSWORD=runtime
POSTGRES_MIGRATOR_USER=app_migrator
POSTGRES_MIGRATOR_PASSWORD=migrator
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
# Generate a random value with at least 32 characters for local use.
BETTER_AUTH_SECRET=replace-with-a-32-character-minimum-secret
# Optional outside the production container; paths are relative to the API working directory.
# WEB_ASSETS_DIR=./public
VITE_API_BASE_URL=http://localhost:3000
NODE_ENV=development
# API docs are enabled by default in development and disabled by default in production.
# Set to true or false to override the environment default.
# API_DOCS_ENABLED=true
LOG_LEVEL=debug
LOG_PRETTY=true
# Append redacted JSON Lines logs here. This directory is ignored by Git.
LOG_FILE=logs/api.jsonl
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL=10000
# The API log SSE endpoint is disabled by default. If enabled, it requires a
# platform-admin fresh Session and keeps a long-lived text/event-stream open.
LOG_STREAM_ENABLED=false
LOG_STREAM_BUFFER_SIZE=1000
LOG_STREAM_HEARTBEAT_MS=15000
