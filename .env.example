# Compose PostgreSQL role passwords. Role names are fixed by the image.
POSTGRES_RUNTIME_PASSWORD=runtime
POSTGRES_MIGRATOR_PASSWORD=migrator

# API and Jobs Worker runtime credentials.
DATABASE_RUNTIME_URL=postgres://app_runtime:runtime@localhost:5432/app
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
# Generate a random value with at least 32 characters for local use.
BETTER_AUTH_SECRET=replace-with-a-32-character-minimum-secret
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
JOBS_POOL_MAX=10
JOBS_WORKER_CONCURRENCY=5

# API options. Boolean values must be exactly "true" or "false".
# API_DOCS_ENABLED is enabled by default in development/test and disabled in production.
# API_DOCS_ENABLED=true
# Optional outside the production container; relative paths resolve from the workspace root.
# WEB_ASSETS_DIR=./public
LOG_FILE=logs/api.jsonl
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL=10000
LOG_STREAM_ENABLED=false
LOG_STREAM_BUFFER_SIZE=1000
LOG_STREAM_HEARTBEAT_MS=15000
JOBS_ENABLED=true
BULL_BOARD_ENABLED=true
BULL_BOARD_BASE_PATH=/admin/queues
BULL_BOARD_CSRF_SECRET=replace-with-at-least-32-random-characters

# Migration process only.
DATABASE_MIGRATOR_URL=postgres://app_migrator:migrator@localhost:5432/app

# One-time initial platform admin provisioning only.
# Existing accounts are promoted without changing their password.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_PASSWORD=Admin123!

# Web build-time configuration.
VITE_API_BASE_URL=http://localhost:3000

# PostgreSQL integration tests or explicit maintenance commands only.
# DATABASE_URL=postgres://app:app@localhost:5432/app
