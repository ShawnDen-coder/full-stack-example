{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@full-stack-example/database": ["./packages/database/src/index.ts"],
      "@full-stack-example/logging": ["./packages/logging/src/index.ts"],
      "@full-stack-example/system": ["./packages/system/src/index.ts"],
      "@full-stack-example/todos": ["./packages/todos/src/index.ts"],
      "@full-stack-example/auth": ["./packages/auth/src/index.ts"],
      "@full-stack-example/auth/client": ["./packages/auth/src/client.ts"],
      "@full-stack-example/auth/contracts": ["./packages/auth/src/contracts.ts"],
      "@full-stack-example/auth/server": ["./packages/auth/src/server.ts"],
      "@full-stack-example/jobs": ["./packages/jobs/src/index.ts"],
      "@full-stack-example/jobs/contracts": ["./packages/jobs/src/contracts.ts"],
      "@full-stack-example/jobs/server": ["./packages/jobs/src/server.ts"],
      "@full-stack-example/jobs/worker": ["./packages/jobs/src/worker.ts"],
      "@full-stack-example/jobs/migration": ["./packages/jobs/src/migration.ts"]
    },
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  }
}
