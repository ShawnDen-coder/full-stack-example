# Production deployment input. Load with: varlock run --path ./deploy/ -- <command>
# @defaultRequired=true
# @defaultSensitive=true
# ---

# HTTPS origin shared by the browser, auth and same-origin API proxy.
# @public @type=url
PUBLIC_APP_URL=

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=string(minLength=1)
POSTGRES_PASSWORD=

# Runtime role: app_server. Same host/database as the migration URL.
# @type=string(minLength=1)
DATABASE_URL=

# Dedicated read-only Worker role: app_worker.
# @type=string(minLength=1)
WORKER_DATABASE_URL=

# Schema owner / role administrator, used only by deployment tasks.
# @type=string(minLength=1)
MIGRATION_DATABASE_URL=

# @public @type=port
WEB_PORT=8080

# @public
COMPOSE_PROJECT_NAME=full-stack-example

# @public @type=number(min=1)
DB_MIGRATION_TIMEOUT_MS=300000

# @public @type=number(min=1)
DB_MIGRATION_LOCK_TIMEOUT_MS=5000

# @public @type=boolean
OTEL_ENABLED=false

# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# @public
OTEL_SERVICE_VERSION=development

# @public @type=number(min=0, max=1)
OTEL_TRACES_SAMPLER_ARG=1
