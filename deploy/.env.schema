# Production deployment input. Load with: varlock run --path ./deploy/ -- <command>
# @defaultRequired=true
# @defaultSensitive=true
# ---

# HTTPS origin shared by the browser, auth and same-origin API proxy.
# @public @type=url
PUBLIC_APP_URL=

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=string(minLength=1)
POSTGRES_PASSWORD=

# URL-encode the password; use postgres:5432/app on the Compose network.
# @type=string(minLength=1)
DATABASE_URL=

# @public @type=port
WEB_PORT=8080

# @public
COMPOSE_PROJECT_NAME=starter
