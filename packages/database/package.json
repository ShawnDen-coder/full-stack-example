{
  "name": "@full-stack-example/database",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle and PostgreSQL client, schema, migrations, and database health probe.",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/run-migrations.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4"
  }
}
